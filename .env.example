# Azure Blob Storage: keeps the original CV files
AZURE_STORAGE_CONNECTION_STRING=
# Prefix: each user gets their own container, named <prefix>-<user id>
AZURE_STORAGE_CONTAINER=cvs

# Azure AI Search: the searchable index of CV chunks
AZURE_SEARCH_ENDPOINT=https://<service>.search.windows.net
AZURE_SEARCH_KEY=
# Prefix: each user gets their own index, named <prefix>-<user id>
AZURE_SEARCH_INDEX=cvs-index

# Azure AI Document Intelligence: reads the layout of PDF and DOCX CVs
AZURE_DOCINTEL_ENDPOINT=https://<resource>.cognitiveservices.azure.com
AZURE_DOCINTEL_KEY=

# Azure OpenAI: use deployment names, not model names
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
# Optional, a smaller and cheaper deployment (for example gpt-4o-mini) that names the chats. Leave empty to name a chat after its first question
AZURE_OPENAI_SMALL_DEPLOYMENT=

# Postgres (docker compose up -d): accounts, sessions, and later chat history
DATABASE_URL=postgresql://cvchat:cvchat@localhost:5432/cvchat

# Optional tunables, validated at start-up. Every one has a default; to change one, uncomment it as CVCHAT_<GROUP>__<NAME>.
# See the Configuration section of README.md for the full list.
# CVCHAT_RETRIEVAL__TOP_K=20
# CVCHAT_RETRIEVAL__TOP_K_FOCUSED=3
# CVCHAT_CHUNKING__MAX_CHARS=4000
# CVCHAT_CONCURRENCY__PER_USER_CHAT=3
# CVCHAT_ACCOUNTS_MAX_USERS=15
