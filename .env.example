# Azure Blob Storage: keeps the original CV files
AZURE_STORAGE_CONNECTION_STRING=
# Prefix: each user gets their own container, named <prefix>-<user id>
AZURE_STORAGE_CONTAINER=cvs

# Azure AI Search: the searchable index of CV chunks
AZURE_SEARCH_ENDPOINT=https://<service>.search.windows.net
AZURE_SEARCH_KEY=
# Prefix: each user gets their own index, named <prefix>-<user id>
AZURE_SEARCH_INDEX=cvs-index

# Azure OpenAI: use deployment names, not model names
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=

# Postgres (docker compose up -d): accounts, sessions, and later chat history
DATABASE_URL=postgresql://cvchat:cvchat@localhost:5432/cvchat
