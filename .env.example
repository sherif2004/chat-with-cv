# Container that holds the PDFs
BLOB_CONTAINER=pdfs

# --- Azure Storage account (use ONE of the two options) ---
# Option A: connection string
AZURE_STORAGE_CONNECTION_STRING=
# Option B: Entra ID (DefaultAzureCredential, e.g. after `az login`)
AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net

# --- Azure OpenAI (key, or leave the key empty to use `az login`) ---
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Embedding deployment name (not the model name)
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
# Must match the embedding model (text-embedding-3-small=1536, -large=3072)
EMBED_DIMENSIONS=1536

# --- Azure AI Search (key, or leave the key empty to use `az login`) ---
AZURE_SEARCH_ENDPOINT=https://<service>.search.windows.net
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=cv-chunks

# CVs processed in parallel
INGEST_WORKERS=4

# Terminal log level for the app (DEBUG, INFO, WARNING)
LOG_LEVEL=INFO

# Device for Docling layout analysis: cpu, cuda, mps or auto (auto fails if your torch build lacks kernels for your GPU)
DOCLING_DEVICE=cpu
